generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SUPERADMIN
  TEACHER
  STUDENT
}

enum Status {
  ACTIVE
  INACTIVE
}

enum GroupStatus {
  NEW
  ACTIVE
  FINISHED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model User {
  id                  Int                  @id @default(autoincrement())
  login               String               @unique
  hashedPassword      String
  fullName            String?
  phone               String?
  imageUrl            String?
  role                Roles
  status              Status               @default(ACTIVE)
  devices             Devices[]
  groups              Group[]
  groupStudents       GroupStudent[]
  attendances         Attendance[]
  payments            Payment[]
  salaries            Salary[]
  examResults         ExamResult[]
  homeworkSubmissions HomeworkSubmission[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Devices {
  deviceId           Int      @id @default(autoincrement())
  device             String
  hashedRefreshToken String
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Course {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  price       Int
  duration    Int
  status      Status   @default(ACTIVE)
  groups      Group[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Room {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  capacity  Int
  groups    Group[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  courseId  Int
  course    Course         @relation(fields: [courseId], references: [id])
  teacherId Int
  teacher   User           @relation(fields: [teacherId], references: [id])
  roomId    Int
  room      Room           @relation(fields: [roomId], references: [id])
  startDate DateTime
  status    GroupStatus    @default(NEW)
  students  GroupStudent[]
  lessons   Lesson[]
  payments  Payment[]
  exams     Exam[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model GroupStudent {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id])
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, studentId])
}

model Lesson {
  id          Int          @id @default(autoincrement())
  groupId     Int
  group       Group        @relation(fields: [groupId], references: [id])
  topic       String
  lessonDate  DateTime
  attendances Attendance[]
  homeworks   Homework[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Attendance {
  id        Int              @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson           @relation(fields: [lessonId], references: [id])
  studentId Int
  student   User             @relation(fields: [studentId], references: [id])
  status    AttendanceStatus
  comment   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([lessonId, studentId])
}

model Payment {
  id        Int           @id @default(autoincrement())
  studentId Int
  student   User          @relation(fields: [studentId], references: [id])
  groupId   Int
  group     Group         @relation(fields: [groupId], references: [id])
  amount    Int
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  comment   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Salary {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   User     @relation(fields: [teacherId], references: [id])
  amount    Int
  month     String
  paidAt    DateTime @default(now())
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, month])
}

model Exam {
  id        Int          @id @default(autoincrement())
  groupId   Int
  group     Group        @relation(fields: [groupId], references: [id])
  title     String
  examDate  DateTime
  maxScore  Int
  results   ExamResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ExamResult {
  id        Int      @id @default(autoincrement())
  examId    Int
  exam      Exam     @relation(fields: [examId], references: [id])
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
}

model Homework {
  id          Int                  @id @default(autoincrement())
  lessonId    Int
  lesson      Lesson               @relation(fields: [lessonId], references: [id])
  title       String
  description String?
  deadline    DateTime
  submissions HomeworkSubmission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model HomeworkSubmission {
  id         Int      @id @default(autoincrement())
  homeworkId Int
  homework   Homework @relation(fields: [homeworkId], references: [id])
  studentId  Int
  student    User     @relation(fields: [studentId], references: [id])
  answer     String
  score      Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([homeworkId, studentId])
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Int
  category  String
  spentAt   DateTime @default(now())
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
